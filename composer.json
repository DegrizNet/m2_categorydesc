{
    "name": "degriznet/m2_categorydesc",
    "description": "Magento 2: extra long category description field, rendered below the product listing.",
    "type": "magento2-module",
    "version": "1.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Anže Voh",
            "email": "anze@degriz.net",
            "homepage": "https://degriz.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0",
        "magento/module-catalog": "^104.0",
        "magento/module-eav": "^102.1"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magelan\\CategoryDesc\\": ""
        }
    },
    "archive": {
        "exclude": [
            "/.gitattributes",
            "/.gitignore",
            "/.github",
            "/dev"
        ]
    },
    "homepage": "https://www.degriz.eu/long-category-description",
    "keywords": [
        "magento",
