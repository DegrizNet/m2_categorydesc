<?php
/** @var \Magento\Catalog\Block\Category\View $block */
/** @var \Magento\Catalog\Helper\Output $output */
$output = $this->helper(\Magento\Catalog\Helper\Output::class); // phpcs:ignore Magento2.Templates.ThisInTemplate
$category = $block->getCurrentCategory();
// The catalog output helper turns {{media url="..."}} from the editor's image button into a real URL.
$longDescription = $category ? $output->categoryAttribute($category, $category->getLongDescription(), 'long_description') : '';
?>

<?php if ($longDescription): ?>
    <div class="category-description category-long-description">
        <?= /* @noEscape */ $longDescription ?>
    </div>
<?php endif; ?>
